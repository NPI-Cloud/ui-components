{
	"compilerOptions": {
		"composite": true,
		"isolatedModules": true,
		"emitDeclarationOnly": true,
		"declaration": true,
		"module": "esnext",
		"moduleResolution": "Bundler",
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		// `bun` for the co-located *.test.ts files. Naming any type package here turns OFF automatic
		// @types inclusion, so anything else this package needs must be referenced explicitly.
		"types": ["bun"],
		"outDir": "./dist"
	},
	"include": ["src"]
}
